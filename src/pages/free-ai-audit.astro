    border: 1px solid var(--op-rule);
    border-left: 3px solid var(--op-orange);
    border-radius: var(--op-radius-sm);
    padding: 10px 14px;
    margin: 0 0 16px;
  }
  .op-ws-privacy strong { color: var(--op-navy); }
  .op-ws-controls { display: flex; gap: 14px; align-items: stretch; margin-top: 6px; }
  .op-ws-btn-back {
    font-size: 11px;
    background: var(--op-paper);
    color: var(--op-navy);
    border: var(--op-border);
    border-radius: var(--op-radius);
    padding: 14px 18px;
    cursor: pointer;
    flex-shrink: 0;
    transition: background var(--op-dur-hover) var(--op-ease), color var(--op-dur-hover) var(--op-ease);
  }
  .op-ws-btn-back:hover { color: var(--op-orange); }
  .op-ws-btn-back[hidden] { display: none; }
  .op-ws-btn-next { flex: 1; }
  .op-ws-btn-next[hidden] { display: none; }

  /* ---- workflow report ---- */
  .op-ws-report { padding: 26px 28px 28px; }
  .op-ws-report[hidden] { display: none; }
  .op-audit-report-head { margin-bottom: 22px; }
  .op-audit-report-eyebrow { font-family: var(--op-font-mono); font-weight: 700; letter-spacing: var(--op-tracking-mono); text-transform: uppercase; font-size: 9px; color: var(--op-orange); }
  .op-audit-report-title { font-family: var(--op-font-display); font-weight: 800; font-size: clamp(22px, 3vw, 30px); letter-spacing: var(--op-tracking-display); color: var(--op-ink); margin: 12px 0 10px; text-wrap: balance; }
  .op-audit-report-summary { font-family: var(--op-font-body); font-size: 14.5px; line-height: 1.6; color: var(--op-navy-soft); margin: 0; }

  .op-ws-ops { display: flex; flex-direction: column; gap: 16px; margin-bottom: 18px; }
  /* :global() — opportunity cards are injected via innerHTML */
  .op-ws-ops :global(.op-ws-op) {
    background: var(--op-paper);
    border: var(--op-border);
    border-radius: var(--op-radius-sm);
    padding: 18px 18px 16px;
