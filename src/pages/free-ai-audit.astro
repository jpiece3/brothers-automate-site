  .op-audit-findings :global(.op-audit-finding--medium) { border-left-color: var(--op-orange); }
  .op-audit-findings :global(.op-audit-finding--low) { border-left-color: var(--green); }
  .op-audit-findings :global(.op-audit-finding-tag) {
