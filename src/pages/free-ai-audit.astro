---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TopUtilityStrip from '../components/operator/TopUtilityStrip.astro';
import EyebrowTag from '../components/operator/EyebrowTag.astro';
import MonoCTA from '../components/operator/MonoCTA.astro';

const SITE_URL = 'https://brothersautomate.com';
const PAGE_URL = `${SITE_URL}/free-ai-audit/`;
// Brendan's calendar. EVERY booking CTA on this page (audit, Workflow Sprint,
// clinic) uses these values. All other site pages stay on James's Cal.
const CAL_LINK = 'brendan-pinder-dp3d5v/30min';
const CAL_NAMESPACE = '30min';

const anchors = [
  { href: '#website-score', label: 'WEBSITE SCORE' },
  { href: '#workflow-scorecard', label: 'WORKFLOW SCORECARD' },
  { href: '#workflow-sprint', label: 'WORKFLOW SPRINT' },
  { href: '#host-a-clinic', label: 'HOST A CLINIC' },
  { href: '#faq', label: 'FAQ' },
];

const interpretCards = [
  {
    tag: 'TRAIN',
    tone: 'navy',
    title: 'Train the team',
    body: 'Work your employees should keep owning, where AI speeds up the drafting, summarizing, and lookup parts. The person stays the decision-maker; they just stop typing everything from scratch.',
  },
  {
    tag: 'AUTOMATE',
    tone: 'green',
    title: 'Automate the process',
    body: 'Genuinely repeatable, rules-based work with a clear trigger and a clear definition of done. These justify building a system that runs consistently in the background, with an exception queue a person reviews.',
  },
  {
    tag: 'CLARIFY FIRST',
    tone: 'orange',
    title: 'Clarify the process first',
    body: 'Work that is too vague or inconsistent to hand to AI yet. Write down the trigger, the inputs, and what a good output looks like. Often the clarity alone fixes half the problem.',
  },
  {
    tag: 'LEAVE ALONE',
    tone: 'red',
    title: 'Leave it alone',
    body: 'High-risk or low-value work where the cost of a wrong output outweighs the time saved. Regulated records, sensitive judgment calls, and rare one-off tasks usually belong here.',
  },
];

const sprintDeliverables = [
  'Short pre-session team survey',
  'Review of representative, sanitized work you send ahead',
  'Two-hour hands-on team session',
  'Three practical workflows built around your actual work',
  'Reusable prompt and workflow playbook',
  'Basic privacy, accuracy, and human-review guardrails',
  'Ranked automation roadmap',
  'One follow-up office-hours session',
];

const clinicPoints = [
  'No generic futurism presentation',
  'No coding required',
  'Two practical live demonstrations',
  'Audience participation, not a lecture',
  'Responsible-use guidance built in',
  'One actionable workflow identified per attendee',
  'Designed for service and technical businesses',
  'Onsite in the Philadelphia region or live online',
];

const examples = [
  {
    name: 'Inbound AI SDR',
    slug: 'inbound-ai-sdr',
    body: 'Reads inbound inquiries, drafts scored replies, and logs everything. Hot leads get flagged for a person; nothing goes out unreviewed until the drafts earn trust.',
  },
  {
    name: 'AI Quote Generator',
    slug: 'cpq-agent',
    body: 'Turns call or form details into a branded draft quote using the company\u2019s own pricing rules. The estimate owner reviews and sends every one.',
  },
  {
    name: 'After-Hours AI Chat',
    slug: 'after-hours-agent',
    body: 'Answers common questions and captures contact details when nobody is at the desk, working from an approved knowledge base, not improvisation.',
  },
];

const faqs = [
  {
    q: 'Is the audit really free?',
    a: 'Yes. The website score, the AI Workflow Scorecard, and the report cost nothing, and there is no card and no obligation. We give the audit away because it is the fastest honest way to show you how we think before you ever pay us anything.',
  },
  {
    q: 'What is the difference between the website score and the workflow audit?',
    a: 'The website score only reads what is publicly visible on your site: speed, mobile experience, SEO basics, trust signals, and how well the site captures leads. It cannot see inside your operation. The AI Workflow Scorecard is where you tell us how inquiries, estimates, follow-up, and admin actually get handled, and that is what the real report is built from.',
  },
  {
    q: 'Do I need a website?',
    a: 'No. If you do not have one, or do not care about the website score, skip straight to the AI Workflow Scorecard. The workflow report does not depend on the website scan.',
  },
  {
    q: 'Will the report recommend automation for everything?',
    a: 'No, and that is the point. Every opportunity gets one of four calls: train the team, automate the process, clarify the process first, or leave it alone. Plenty of work should stay manual, and the report says so when that is the honest answer.',
  },
  {
    q: 'What is an AI Workflow Sprint?',
    a: 'A private, hands-on session for your team, onsite in the Philadelphia region or live online. We work with your actual emails, estimates, reports, and recurring admin, your employees learn to use AI safely on real tasks, and you leave with working examples, a prompt playbook, and a ranked roadmap of what to automate next.',
  },
  {
    q: 'Is this employee training or automation consulting?',
    a: 'Both, deliberately. Training handles the work your employees should continue to own. Automation handles the repeatable processes that should run consistently in the background. The sprint and the report both separate the two, because treating everything as an automation project is how AI initiatives fail.',
  },
  {
    q: 'Can the session be onsite?',
    a: 'Yes. We deliver sprints and clinics onsite in the Philadelphia region, or live online for teams elsewhere.',
  },
  {
    q: 'Can a chamber or association host a clinic?',
    a: 'Yes. We run a free 45-minute AI Workflow Clinic for chambers, trade associations, coworking communities, banks, accountants, MSPs, and similar groups. Members get a practical, hands-on introduction using the work small businesses actually repeat, and everyone leaves with a worksheet they can use with their own team.',
  },
  {
    q: 'What information should we avoid sharing?',
    a: 'Never send passwords, private customer data, medical information, payment details, regulated records, or anything confidential, not in the scorecard, and not in a sprint. Sanitized examples with the sensitive parts removed or described work just as well.',
  },
  {
    q: 'Who conducts the sprint?',
    a: 'Brendan Pinder. Brothers Automate is run by two brothers who came up operating service businesses, not selling software. Brendan personally reads every scorecard submission and runs the sprint and clinic sessions.',
  },
  {
    q: 'Where do booking requests go?',
    a: 'Every booking button on this page opens Brendan\u2019s calendar directly. Brendan handles the audit review, Workflow Sprint, and clinic conversations himself.',
  },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Free AI Audit', item: PAGE_URL },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Free AI Workflow Audit',
  provider: { '@type': 'Organization', name: 'Brothers Automate', url: SITE_URL },
  areaServed: 'United States',
  description:
    'A free AI workflow audit for service and technical businesses: an instant website and lead-capture score, a 10-question AI Workflow Scorecard, and a prioritized report showing where to train, automate, clarify, or leave a process alone.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<Layout
  title="Free AI Workflow Audit for Service Businesses | Brothers Automate"
  description="Start with a free website and lead-capture score, then map your real workflows with the AI Workflow Scorecard. Get a prioritized report showing where to train your team, automate, or leave a process alone. Free, no obligation."
  canonicalUrl={PAGE_URL}
  extraSchemas={[breadcrumbSchema, faqSchema, serviceSchema]}
>
  <Header />
  <main>
    <!-- ============================ HERO + WEBSITE SCORE ============================ -->
    <section class="op-audit-hero op-grid-bg" id="website-score">
      <div class="op-audit-frame">
        <div class="op-audit-util">
          <TopUtilityStrip
            left="BROTHERS_AUTOMATE / WORKFLOW AUDIT · FREE"
            right="● AUDIT ENGINE ONLINE · NO CARD REQUIRED"
            bordered
          />
        </div>

        <div class="op-audit-grid">
          <div class="op-audit-intro">
            <EyebrowTag label="FREE AI WORKFLOW AUDIT · FOR SERVICE & TECHNICAL BUSINESSES" />
            <h1 class="op-audit-h1" data-animate="fade-up">
              Find the AI workflows your team<br />
              <span class="op-audit-h1-orange">can actually use.</span>
            </h1>
            <p class="op-audit-sub" data-animate="fade-up">
              Start with a free website and lead-capture score. Then tell us how your team handles
              inquiries, estimates, follow-up, and admin. We&rsquo;ll map the strongest opportunities,
              show where a person stays in control, and recommend whether to train, automate, or
              leave the process alone.
            </p>
            <div class="op-audit-hero-ctas" data-animate="fade-up">
              <a href="#website-score" class="op-audit-cal-cta op-mono" id="hero-run-audit">
                RUN MY FREE AUDIT <span aria-hidden="true">→</span>
              </a>
              <a
                href="#workflow-sprint"
                class="op-audit-hero-secondary op-mono"
                id="hero-bring-ai"
                data-track="cta_click"
                data-track-location="audit-hero"
                data-track-label="Bring AI To My Team"
              >
                BRING AI TO MY TEAM <span aria-hidden="true">↓</span>
              </a>
            </div>
            <nav class="op-audit-anchor-nav op-mono" aria-label="On this page">
              <span class="op-audit-anchor-head">ON THIS PAGE</span>
              {anchors.map((a) => (
                <a href={a.href}>{a.label}</a>
              ))}
            </nav>
          </div>

          <!-- WEBSITE & LEAD-CAPTURE SCORE CONSOLE -->
          <div class="op-audit-panel" data-animate="fade-up">
            <div class="op-audit-panel-header">
              <span class="op-pulse-dot"></span>
              <span class="op-mono op-audit-panel-id">WEBSITE &amp; LEAD-CAPTURE SCORE</span>
              <span class="op-mono op-audit-panel-status" id="audit-status">● READY</span>
            </div>

            <!-- STAGE: input -->
            <div class="op-audit-stage" id="stage-input">
              <p class="op-audit-stage-intro">
                Assessment 1 of 2. This scan reads what is publicly visible on your website:
                speed, mobile experience, SEO basics, trust signals, and how well the site
                captures leads. It can&rsquo;t see inside your operation &mdash; that&rsquo;s
                what the Workflow Scorecard below is for.
              </p>
              <form id="audit-scan-form" novalidate>
                <label class="op-audit-field">
                  <span class="op-mono op-audit-label">YOUR WEBSITE</span>
                  <input
                    type="text"
                    id="audit-url"
                    name="url"
                    inputmode="url"
                    autocomplete="url"
                    placeholder="yourcompany.com"
                    maxlength="300"
                  />
                </label>
                <button type="submit" id="audit-scan-btn" class="op-audit-submit op-mono">
                  <span class="op-audit-submit-label">RUN MY FREE WEBSITE AUDIT</span>
                  <span class="op-audit-submit-arrow" aria-hidden="true">→</span>
                </button>
                <p class="op-audit-fineprint op-mono">FREE · INSTANT SCORE · ~20 SECONDS · NO SIGNUP TO SEE IT</p>
                <p class="op-audit-error" id="scan-error" role="alert" aria-live="polite"></p>
              </form>
              <p class="op-audit-skip">
                No website? <a href="#workflow-scorecard" id="skip-to-scorecard">Skip to the AI Workflow Scorecard →</a>
              </p>
            </div>

            <!-- STAGE: loading -->
            <div class="op-audit-stage" id="stage-loading" hidden>
              <p class="op-mono op-audit-loading-head"><span class="op-pulse-dot"></span> SCANNING <span id="loading-domain">YOUR SITE</span></p>
              <ul class="op-audit-steps op-mono" id="loading-steps">
                <li data-step>FETCHING PAGE</li>
                <li data-step>CHECKING SEO &amp; META</li>
                <li data-step>CHECKING RESPONSIVE SETUP &amp; SPEED DATA</li>
                <li data-step>SCORING LEAD CAPTURE</li>
                <li data-step>COMPILING FINDINGS</li>
              </ul>
            </div>

            <!-- STAGE: teaser -->
            <div class="op-audit-stage" id="stage-teaser" hidden>
              <div class="op-audit-findings op-audit-findings--priority">
                <p class="op-mono op-audit-findings-head">PRIORITY OPPORTUNITIES</p>
                <p class="op-audit-findings-intro">
                  Start here. These specific observations matter more than the directional grade below.
                </p>
                <ul id="teaser-findings"></ul>
              </div>

              <div class="op-audit-scoreline">
                <div class="op-audit-gauge" id="score-gauge">
                  <div class="op-audit-gauge-inner">
                    <span class="op-audit-gauge-num" id="score-num">0</span>
                    <span class="op-audit-gauge-of op-mono">/100</span>
                  </div>
                </div>
                <div class="op-audit-scoremeta">
                  <span class="op-mono op-audit-scoremeta-label">WEBSITE SCORE · <span id="score-domain"></span></span>
                  <span class="op-audit-grade" id="score-grade">B</span>
                  <span class="op-audit-grade-note op-mono" id="score-note"></span>
                </div>
              </div>

              <div class="op-audit-cats" id="score-cats"></div>
              <p class="op-audit-score-disclaimer">
                This is a directional scan of public signals, not a complete conversion or usability review.
                When Google Lighthouse is unavailable, server response and responsive setup are labeled separately.
              </p>

              <div class="op-audit-gate">
                <div class="op-audit-gate-head">
                  <span class="op-pulse-dot"></span>
                  <span class="op-mono">NEXT: THE AI WORKFLOW SCORECARD</span>
                </div>
                <p class="op-audit-gate-sub">
                  That score covers what&rsquo;s visible from the outside. The real opportunities
                  live in how your team handles inquiries, estimates, follow-up, and admin.
                  Ten questions, about three minutes, and your report is built from what you
                  actually tell us &mdash; not from your URL.
                </p>
                <button type="button" id="teaser-continue" class="op-audit-submit op-mono">
                  <span class="op-audit-submit-label">CONTINUE TO THE SCORECARD</span>
                  <span class="op-audit-submit-arrow" aria-hidden="true">↓</span>
                </button>
                <p class="op-audit-fineprint op-mono">FREE · YOUR ANSWERS STAY PRIVATE · BRENDAN READS EVERY ONE</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================ AI WORKFLOW SCORECARD ============================ -->
    <section class="op-audit-scorecard op-grid-bg" id="workflow-scorecard">
      <div class="op-audit-section-frame">
        <div class="op-audit-section-head">
          <EyebrowTag label="ASSESSMENT 2 OF 2 · AI WORKFLOW SCORECARD" variant="paper" />
          <h2 class="op-audit-h2">Tell us how the work actually gets done.</h2>
          <p class="op-audit-section-sub">
            A website scan can&rsquo;t see your inbox, your estimates, or your follow-up. These
            ten questions can. Answer in plain language &mdash; the more specific you are, the
            more useful the report. Brendan reads every submission.
          </p>
        </div>

        <aside class="op-ws-sample" aria-labelledby="sample-report-title">
          <div class="op-ws-sample-head">
            <div>
              <span class="op-mono op-ws-sample-eyebrow">ANONYMIZED EXAMPLE · ILLUSTRATIVE, NOT A CLIENT RESULT</span>
              <h3 id="sample-report-title">See what the finished report actually tells you.</h3>
            </div>
            <span class="op-ws-op-chip op-ws-op-chip--automate">AUTOMATE</span>
          </div>
          <div class="op-ws-sample-grid">
            <div>
              <span class="op-ws-op-key">Current process</span>
              <p>A service company re-types website inquiries into its job system, then an office manager assigns each one by hand.</p>
            </div>
            <div>
              <span class="op-ws-op-key">Proposed workflow</span>
              <p>Send each inquiry into the job system, flag missing details, and place exceptions in a review queue.</p>
            </div>
            <div>
              <span class="op-ws-op-key">Human review</span>
              <p>The office manager reviews exceptions and keeps control of assignment rules.</p>
            </div>
            <div>
              <span class="op-ws-op-key">Estimate &amp; assumptions</span>
              <p>Needs confirmation until volume, minutes per inquiry, and integration access are verified.</p>
            </div>
          </div>
          <p class="op-ws-sample-note">
            Your report uses your answers and makes the same call for each opportunity: train, automate, clarify first, or leave it alone.
          </p>
        </aside>

        <div class="op-ws-panel" id="ws-panel">
          <div class="op-audit-panel-header">
            <span class="op-pulse-dot"></span>
            <span class="op-mono op-audit-panel-id">AI WORKFLOW SCORECARD</span>
            <span class="op-mono op-audit-panel-status" id="ws-status">● READY</span>
          </div>

          <!-- FORM -->
          <form id="ws-form" novalidate>
            <div class="op-ws-progress" aria-hidden="false">
              <span class="op-mono op-ws-progress-label">STEP <span id="ws-step-num">1</span> / 5 · <span id="ws-step-title">YOUR BUSINESS</span></span>
              <div class="op-ws-progress-bar"><span id="ws-progress-fill" style="width: 20%"></span></div>
            </div>

            <!-- STEP 1: your business -->
            <fieldset class="op-ws-step" data-ws-step="1" data-ws-title="YOUR BUSINESS">
              <legend class="op-ws-legend" tabindex="-1">About your business</legend>

              <label class="op-audit-field op-ws-field">
                <span class="op-mono op-audit-label">WHAT TYPE OF BUSINESS DO YOU OPERATE? <span class="op-audit-req">*</span></span>
                <input type="text" id="ws-business-type" name="business_type" maxlength="200" placeholder="e.g. HVAC contractor, structural engineering firm, IT MSP" autocomplete="organization-title" />
              </label>

              <div class="op-ws-field" role="radiogroup" aria-labelledby="ws-team-label">
                <span class="op-mono op-audit-label" id="ws-team-label">HOW MANY PEOPLE HANDLE OFFICE, ADMIN, SALES, OR COORDINATION WORK? <span class="op-audit-req">*</span></span>
                <div class="op-ws-pills">
                  <label class="op-ws-pill"><input type="radio" name="team_size" value="just-me" /><span>Just me</span></label>
                  <label class="op-ws-pill"><input type="radio" name="team_size" value="2-4" /><span>2&ndash;4</span></label>
                  <label class="op-ws-pill"><input type="radio" name="team_size" value="5-10" /><span>5&ndash;10</span></label>
                  <label class="op-ws-pill"><input type="radio" name="team_size" value="11+" /><span>11+</span></label>
                </div>
              </div>
            </fieldset>

            <!-- STEP 2: where time goes -->
            <fieldset class="op-ws-step" data-ws-step="2" data-ws-title="WHERE TIME GOES" hidden>
              <legend class="op-ws-legend" tabindex="-1">Where the time goes</legend>

              <label class="op-audit-field op-ws-field">
                <span class="op-mono op-audit-label">WHAT WORK REGULARLY EATS THE OWNER&rsquo;S TIME AFTER HOURS?</span>
                <textarea id="ws-after-hours" name="after_hours" rows="3" maxlength="1500" placeholder="e.g. Writing estimates at night, catching up on email, chasing unpaid invoices..."></textarea>
              </label>

              <label class="op-audit-field op-ws-field">
                <span class="op-mono op-audit-label">WHICH TASKS REPEAT DAILY OR WEEKLY? <span class="op-audit-req">*</span></span>
                <textarea id="ws-repeat-tasks" name="repeat_tasks" rows="3" maxlength="1500" placeholder="e.g. Scheduling jobs, sending follow-up emails, updating the job spreadsheet, weekly reports..."></textarea>
              </label>
            </fieldset>

            <!-- STEP 3: how work moves -->
            <fieldset class="op-ws-step" data-ws-step="3" data-ws-title="HOW WORK MOVES" hidden>
              <legend class="op-ws-legend" tabindex="-1">How work moves through the business</legend>

              <label class="op-audit-field op-ws-field">
                <span class="op-mono op-audit-label">HOW ARE NEW INQUIRIES RECEIVED, ASSIGNED, AND FOLLOWED UP? <span class="op-audit-req">*</span></span>
                <textarea id="ws-inquiries" name="inquiries" rows="3" maxlength="1500" placeholder="e.g. Calls go to the office phone, emails sit in one inbox, whoever is free follows up..."></textarea>
              </label>

              <label class="op-audit-field op-ws-field">
                <span class="op-mono op-audit-label">HOW ARE ESTIMATES, PROPOSALS, OR REPORTS CREATED?</span>
                <textarea id="ws-estimates" name="estimates" rows="3" maxlength="1500" placeholder="e.g. Copy an old Word doc, change the numbers, PDF it, email it out..."></textarea>
              </label>

              <label class="op-audit-field op-ws-field">
                <span class="op-mono op-audit-label">WHICH TOOLS DOES THE TEAM USE TODAY?</span>
                <input type="text" id="ws-tools" name="tools" maxlength="500" placeholder="e.g. Gmail, QuickBooks, Jobber, Excel, a shared drive" />
              </label>
            </fieldset>

            <!-- STEP 4: friction -->
            <fieldset class="op-ws-step" data-ws-step="4" data-ws-title="THE FRICTION" hidden>
              <legend class="op-ws-legend" tabindex="-1">Where the friction is</legend>

              <label class="op-audit-field op-ws-field">
                <span class="op-mono op-audit-label">WHERE IS INFORMATION COPIED BY HAND BETWEEN EMAILS, DOCS, FORMS, CRMS, OR SPREADSHEETS?</span>
                <textarea id="ws-copying" name="copying" rows="3" maxlength="1500" placeholder="e.g. Form submissions get re-typed into the CRM, invoice details copied from email into QuickBooks..."></textarea>
              </label>

              <label class="op-audit-field op-ws-field">
                <span class="op-mono op-audit-label">WHAT WORK GETS DELAYED, FORGOTTEN, OR DEPENDS ON ONE PERSON?</span>
                <textarea id="ws-delays" name="delays" rows="3" maxlength="1500" placeholder="e.g. Follow-ups slip when we get busy, only Maria knows how to do the permit paperwork..."></textarea>
              </label>

              <div class="op-audit-row">
                <label class="op-audit-field op-ws-field">
                  <span class="op-mono op-audit-label">HOW OFTEN DOES YOUR MOST TIME-CONSUMING PROCESS HAPPEN?</span>
                  <select id="ws-frequency" name="frequency" class="op-ws-select">
                    <option value="not-sure" selected>Not sure</option>
                    <option value="multiple-daily">Several times a day</option>
                    <option value="daily">About daily</option>
                    <option value="few-weekly">A few times a week</option>
                    <option value="weekly">About weekly</option>
                    <option value="monthly">About monthly</option>
                  </select>
                </label>
                <label class="op-audit-field op-ws-field">
                  <span class="op-mono op-audit-label">HOW LONG DOES EACH OCCURRENCE TAKE?</span>
                  <select id="ws-time-each" name="time_each" class="op-ws-select">
                    <option value="not-sure" selected>Not sure</option>
                    <option value="under-15">Under 15 minutes</option>
                    <option value="15-30">15&ndash;30 minutes</option>
                    <option value="30-60">30&ndash;60 minutes</option>
                    <option value="60-120">1&ndash;2 hours</option>
                    <option value="over-120">More than 2 hours</option>
                  </select>
                </label>
              </div>

              <label class="op-audit-field op-ws-field">
                <span class="op-mono op-audit-label">OPTIONAL: DESCRIBE OR PASTE A SANITIZED EXAMPLE OF THE EMAIL, DOCUMENT, OR PROCESS</span>
                <textarea id="ws-example" name="example" rows="4" maxlength="4000" placeholder="A typical inquiry email, an estimate outline, the steps of the process... with anything sensitive removed."></textarea>
              </label>
              <p class="op-ws-privacy">
                <strong>Please don&rsquo;t paste</strong> passwords, private customer data, medical
                information, payment details, regulated records, or anything confidential.
                A described example with the sensitive parts removed works just as well.
              </p>
            </fieldset>

            <!-- STEP 5: contact -->
            <fieldset class="op-ws-step" data-ws-step="5" data-ws-title="GET YOUR REPORT" hidden>
              <legend class="op-ws-legend" tabindex="-1">Who should Brendan follow up with?</legend>

              <div class="op-audit-row">
                <label class="op-audit-field op-ws-field">
                  <span class="op-mono op-audit-label">NAME <span class="op-audit-req">*</span></span>
