    border-radius: 99px;
    border: 1.5px solid currentColor;
  }
  .op-audit-interpret-tag--navy { color: var(--op-navy); }
  .op-audit-interpret-tag--green { color: var(--green); }
  .op-audit-interpret-tag--orange { color: var(--op-orange); }
  .op-audit-interpret-tag--red { color: var(--red); }
  .op-audit-interpret-title { font-family: var(--op-font-display); font-weight: 800; font-size: 17px; color: var(--op-ink); margin: 12px 0 8px; }
  .op-audit-interpret-body { font-family: var(--op-font-body); font-size: 13.5px; line-height: 1.55; color: var(--op-navy-soft); margin: 0; }

  /* ---- sprint ---- */
  .op-audit-sprint { background: var(--op-navy); padding: var(--op-section-py) 0; }
  .op-audit-sprint :global(.op-eyebrow) { margin-bottom: 18px; }
