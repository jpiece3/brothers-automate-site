  }
  .op-ws-sample .op-ws-op-chip--automate { color: var(--green); }
  .op-ws-sample-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--op-rule); border-left: 1px solid var(--op-rule); }
  .op-ws-sample-grid > div { padding: 13px 14px; border-right: 1px solid var(--op-rule); border-bottom: 1px solid var(--op-rule); }
  .op-ws-sample .op-ws-op-key { display: block; font-family: var(--op-font-mono); font-size: 8.5px; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; color: var(--op-navy-soft); margin-bottom: 6px; }
  .op-ws-sample-grid p { font-family: var(--op-font-body); font-size: 12.5px; line-height: 1.5; color: var(--op-navy); margin: 0; }
  .op-ws-sample-note { font-family: var(--op-font-body); font-size: 12px; line-height: 1.5; color: var(--op-navy-soft); margin: 14px 0 0; }
  .op-ws-panel {
    max-width: 880px;
    background: var(--op-cream);
    border: var(--op-border);
    border-radius: var(--op-radius-md);
    overflow: hidden;
    box-shadow: var(--op-shadow-lg);
  }
  #ws-form { padding: 26px 28px 26px; }
  #ws-form[hidden] { display: none; }

  .op-ws-progress { margin-bottom: 24px; }
  .op-ws-progress-label { font-size: 10px; color: var(--op-navy); display: block; margin-bottom: 8px; }
  .op-ws-progress-bar { height: 6px; background: var(--op-rule-soft); border-radius: 99px; overflow: hidden; }
  .op-ws-progress-bar span { display: block; height: 100%; background: var(--op-orange); border-radius: 99px; transition: width var(--op-dur-base) var(--op-ease); }

  .op-ws-step { border: none; padding: 0; margin: 0; min-width: 0; }
  .op-ws-step[hidden] { display: none; }
  .op-ws-legend {
    font-family: var(--op-font-display);
    font-weight: 800;
    font-size: 18px;
    color: var(--op-ink);
    padding: 0;
    margin: 0 0 18px;
  }
  .op-ws-legend:focus { outline: none; }
  .op-ws-field { margin-bottom: 18px; }

  .op-ws-pills { display: flex; flex-wrap: wrap; gap: 10px; }
  .op-ws-pill { position: relative; cursor: pointer; }
  .op-ws-pill input {
    position: absolute; opacity: 0; width: 100%; height: 100%; inset: 0; margin: 0; cursor: pointer;
  }
  .op-ws-pill span {
    display: inline-block;
    font-family: var(--op-font-body);
    font-size: 14px;
    font-weight: 600;
    color: var(--op-navy);
