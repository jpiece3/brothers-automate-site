  <script is:inline>
    (function () {
      var SCAN_URL = '/api/audit-scan';
      var WORKFLOW_URL = '/api/workflow-submit';

      var prefersReduced = false;
      try { prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
      function scrollToEl(el) {
        if (el) el.scrollIntoView({ behavior: prefersReduced ? 'auto' : 'smooth', block: 'start' });
      }
      function track(name, params) {
        if (typeof gtag !== 'undefined') { try { gtag('event', name, params || {}); } catch (e) {} }
      }
      function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }

      // ---- attribution: ?ref=partner&event=name + UTM params, kept for the
      // session so anchors/refreshes don't lose them. Only categorical values
      // are stored; no free text.
      var attribution = (function () {
        var attr = {};
        try { attr = JSON.parse(sessionStorage.getItem('ba_audit_attr') || '{}') || {}; } catch (e) { attr = {}; }
        try {
          var params = new URLSearchParams(window.location.search);
          ['ref', 'event', 'utm_source', 'utm_medium', 'utm_campaign'].forEach(function (k) {
            var v = params.get(k);
            if (v) attr[k] = String(v).slice(0, 120);
          });
          sessionStorage.setItem('ba_audit_attr', JSON.stringify(attr));
        } catch (e) {}
        return attr;
      })();
      function attributionPayload() {
        return {
          lead_source: attribution.ref ? 'partner_referral' : (attribution.utm_source ? 'campaign' : 'direct'),
          referral_partner: attribution.ref || '',
          event_name: attribution.event || '',
          utm_source: attribution.utm_source || '',
          utm_medium: attribution.utm_medium || '',
          utm_campaign: attribution.utm_campaign || '',
        };
      }

      // ---- Cal open tracking: every Brendan CTA on this page ----
      document.addEventListener('click', function (e) {
        var cal = e.target.closest && e.target.closest('[data-cal-link]');
        if (!cal) return;
        var loc = cal.getAttribute('data-track-location') || 'unknown';
        var intent = cal.getAttribute('data-intent') || 'workflow_audit';
        track('cal_opened', { source: loc, intent: intent, ref: attribution.ref || '(none)' });
        if (loc === 'workflow-sprint') track('sprint_cta_click', { label: cal.getAttribute('data-track-label') || '' });
        if (loc === 'clinic') track('clinic_cta_click', { label: cal.getAttribute('data-track-label') || '' });
      });

      // ---- worksheet download tracking ----
      document.addEventListener('click', function (e) {
        var link = e.target.closest && e.target.closest('[data-worksheet]');
        if (link) track('worksheet_downloaded', { from: window.location.hash || 'page' });
      });

      // =====================================================================
      // WEBSITE & LEAD-CAPTURE SCORE (assessment 1)
      // =====================================================================
      var scanForm = document.getElementById('audit-scan-form');
      var stages = {
        input: document.getElementById('stage-input'),
        loading: document.getElementById('stage-loading'),
        teaser: document.getElementById('stage-teaser'),
      };
      var statusEl = document.getElementById('audit-status');
      var scanBtn = document.getElementById('audit-scan-btn');
      var scanError = document.getElementById('scan-error');
      var scanData = null;

      function show(stage) {
        Object.keys(stages).forEach(function (k) {
          if (stages[k]) stages[k].hidden = k !== stage;
        });
      }
      function setStatus(text) { if (statusEl) statusEl.textContent = text; }
      function setError(el, msg) {
        if (!el) return;
        el.textContent = msg || '';
        el.style.display = msg ? 'block' : 'none';
      }
      function bandColor(score) {
        if (score >= 75) return 'var(--green)';
        if (score >= 45) return 'var(--op-orange)';
        return 'var(--red)';
      }

      var loadingTimer = null;
      function startLoading(domain) {
        var dEl = document.getElementById('loading-domain');
        if (dEl) dEl.textContent = (domain || 'your site').toUpperCase();
        var steps = Array.prototype.slice.call(document.querySelectorAll('#loading-steps [data-step]'));
        steps.forEach(function (s) { s.classList.remove('is-done', 'is-active'); });
        var i = 0;
        if (steps[0]) steps[0].classList.add('is-active');
        loadingTimer = setInterval(function () {
          if (steps[i]) { steps[i].classList.remove('is-active'); steps[i].classList.add('is-done'); }
          i++;
          if (i < steps.length) steps[i].classList.add('is-active');
          else clearInterval(loadingTimer);
        }, 1400);
      }
      function stopLoading() { if (loadingTimer) clearInterval(loadingTimer); }

      function renderTeaser(data) {
        var num = document.getElementById('score-num');
        var grade = document.getElementById('score-grade');
        var gauge = document.getElementById('score-gauge');
        var note = document.getElementById('score-note');
        var domEl = document.getElementById('score-domain');
        if (domEl) domEl.textContent = data.domain || '';
        if (grade) grade.textContent = data.grade;
        if (gauge) gauge.style.setProperty('--gauge-color', bandColor(data.score));
        if (note) {
          note.textContent = 'Directional grade · findings first';
        }
        if (num) {
          if (prefersReduced) {
            num.textContent = data.score;
            if (gauge) gauge.style.setProperty('--gauge-pct', data.score + '%');
          } else {
            var target = data.score, start = performance.now(), dur = 900;
            (function tick(now) {
              var t = Math.min(1, (now - start) / dur);
              var eased = 1 - Math.pow(1 - t, 3);
              num.textContent = Math.round(target * eased);
              if (gauge) gauge.style.setProperty('--gauge-pct', (target * eased) + '%');
              if (t < 1) requestAnimationFrame(tick);
            })(start);
          }
        }

        var cats = document.getElementById('score-cats');
        if (cats) {
          cats.innerHTML = data.categories.map(function (c) {
            return (
              '<div class="op-audit-cat">' +
              '<div class="op-audit-cat-top">' +
              '<span class="op-audit-cat-label">' + esc(c.label) + '</span>' +
              '<span class="op-audit-cat-score" style="color:' + bandColor(c.score) + '">' + c.score + '</span>' +
              '</div>' +
              '<div class="op-audit-cat-bar"><span style="width:' + c.score + '%;background:' + bandColor(c.score) + '"></span></div>' +
              '<p class="op-audit-cat-detail">' + esc(c.detail || '') + '</p>' +
              '</div>'
            );
          }).join('');
        }

        var findings = document.getElementById('teaser-findings');
        if (findings) {
          findings.innerHTML = data.teaser.map(function (f) {
            return (
              '<li class="op-audit-finding op-audit-finding--' + esc(f.severity) + '">' +
              '<p class="op-audit-finding-tag">' + esc(f.label) + '</p>' +
              '<p class="op-audit-finding-msg">' + esc(f.message) + '</p></li>'
            );
          }).join('');
        }
      }

      if (scanForm) {
        scanForm.addEventListener('submit', function (e) {
          e.preventDefault();
          setError(scanError, '');
          var url = (document.getElementById('audit-url').value || '').trim();
          if (!url || url.indexOf('.') === -1) {
            setError(scanError, 'Enter your website address, e.g. yourcompany.com');
            return;
          }
          var domainGuess = url.replace(/^https?:\/\//i, '').replace(/^www\./i, '').split('/')[0];
          scanBtn.disabled = true;
          setStatus('● SCANNING');
          show('loading');
          startLoading(domainGuess);
          track('audit_scan_started', {});

          fetch(SCAN_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ url: url }),
          })
            .then(function (res) {
              return res.json().then(function (data) {
                if (!res.ok) throw new Error(data && data.error ? data.error : 'Scan failed.');
                return data;
              });
            })
            .then(function (data) {
              scanData = data;
              stopLoading();
              renderTeaser(data);
              setStatus('● SCORE READY');
              show('teaser');
              track('audit_scan_complete', { score: data.score });
              if (typeof fbq !== 'undefined') { try { fbq('trackCustom', 'AuditScan', { score: data.score }); } catch (e) {} }
              scrollToEl(stages.teaser);
            })
            .catch(function (err) {
              stopLoading();
              scanBtn.disabled = false;
              setStatus('● READY');
              show('input');
              setError(scanError, err.message || "We couldn't scan that site. Check the address and try again.");
            });
        });
      }

      // Hero "RUN MY FREE AUDIT": scroll to the console + focus the URL field.
      var heroRun = document.getElementById('hero-run-audit');
      if (heroRun) {
        heroRun.addEventListener('click', function (e) {
          e.preventDefault();
          track('cta_click', { cta_location: 'audit-hero', cta_text: 'Run My Free Audit' });
          var input = document.getElementById('audit-url');
          scrollToEl(document.getElementById('website-score'));
          if (input) setTimeout(function () { input.focus({ preventScroll: true }); }, prefersReduced ? 0 : 450);
        });
      }

      // =====================================================================
      // AI WORKFLOW SCORECARD (assessment 2)
      // =====================================================================
      var wsForm = document.getElementById('ws-form');
      var wsReport = document.getElementById('ws-report');
      if (!wsForm) return;

      var wsSteps = Array.prototype.slice.call(wsForm.querySelectorAll('[data-ws-step]'));
      var wsBack = document.getElementById('ws-back');
      var wsNext = document.getElementById('ws-next');
      var wsSubmit = document.getElementById('ws-submit');
      var wsError = document.getElementById('ws-error');
      var wsStatus = document.getElementById('ws-status');
      var wsStepNum = document.getElementById('ws-step-num');
      var wsStepTitle = document.getElementById('ws-step-title');
      var wsProgressFill = document.getElementById('ws-progress-fill');
      var wsPrint = document.getElementById('ws-print-report');
      var current = 0;
      var scorecardStarted = false;

      function markStarted(path) {
        if (scorecardStarted) return;
        scorecardStarted = true;
        track('workflow_scorecard_started', { path: path || 'direct' });
      }

      function val(id) {
        var el = document.getElementById(id);
        return el ? (el.value || '').trim() : '';
      }
      function radioVal(name) {
        var el = wsForm.querySelector('input[name="' + name + '"]:checked');
        return el ? el.value : '';
      }

      function showStep(idx, focusLegend) {
        current = Math.max(0, Math.min(idx, wsSteps.length - 1));
        wsSteps.forEach(function (s, i) { s.hidden = i !== current; });
        var isLast = current === wsSteps.length - 1;
        wsBack.hidden = current === 0;
        wsNext.hidden = isLast;
        wsSubmit.hidden = !isLast;
        if (wsStepNum) wsStepNum.textContent = String(current + 1);
        if (wsStepTitle) wsStepTitle.textContent = wsSteps[current].getAttribute('data-ws-title') || '';
        if (wsProgressFill) wsProgressFill.style.width = (((current + 1) / wsSteps.length) * 100) + '%';
        setError(wsError, '');
        if (focusLegend) {
          var legend = wsSteps[current].querySelector('.op-ws-legend');
          if (legend) legend.focus({ preventScroll: true });
        }
      }

      function validateStep(idx) {
        if (idx === 0) {
          if (!val('ws-business-type')) return 'Tell us what type of business you operate.';
          if (!radioVal('team_size')) return 'Pick how many people handle the office and coordination work.';
        }
        if (idx === 1 && !val('ws-repeat-tasks')) return 'List at least a couple of the tasks that repeat every day or week.';
        if (idx === 2 && !val('ws-inquiries')) return 'Describe how new inquiries come in and get followed up, even one sentence helps.';
        if (idx === 4) {
          if (!val('ws-name')) return 'Please enter your name.';
          var email = val('ws-email');
          if (!email || email.indexOf('@') === -1 || email.indexOf('.') === -1) return 'Please enter a valid email.';
        }
        return '';
      }

      wsNext.addEventListener('click', function () {
        var err = validateStep(current);
        if (err) { setError(wsError, err); return; }
        showStep(current + 1, true);
        track('workflow_scorecard_step', { step: current + 1 });
      });
      wsBack.addEventListener('click', function () {
        showStep(current - 1, true);
      });
      wsForm.addEventListener('focusin', function () { markStarted('direct'); });

      // Skip link + teaser continue both route here.
      function goToScorecard(path) {
        markStarted(path);
        scrollToEl(document.getElementById('workflow-scorecard'));
        setTimeout(function () {
          var first = document.getElementById('ws-business-type');
          if (first && current === 0) first.focus({ preventScroll: true });
        }, prefersReduced ? 0 : 450);
      }
      var skipLink = document.getElementById('skip-to-scorecard');
      if (skipLink) {
        skipLink.addEventListener('click', function (e) {
          e.preventDefault();
          goToScorecard('skipped_website');
        });
      }
      var teaserContinue = document.getElementById('teaser-continue');
      if (teaserContinue) {
        teaserContinue.addEventListener('click', function () {
          goToScorecard('after_website_score');
        });
      }
      // Support /free-ai-audit/?ref=...#workflow-scorecard deep links.
      if (window.location.hash === '#workflow-scorecard') {
        setTimeout(function () { goToScorecard('deep_link'); }, 300);
      }

      function nextStepMeta(step) {
        switch (step) {
          case 'train': return { label: 'TRAIN THE TEAM', cls: 'train' };
          case 'automate': return { label: 'AUTOMATE', cls: 'automate' };
          case 'leave': return { label: 'LEAVE IT ALONE', cls: 'leave' };
          default: return { label: 'CLARIFY FIRST', cls: 'clarify' };
        }
      }

      function renderWorkflowReport(report) {
        var h = document.getElementById('ws-report-headline');
        var sum = document.getElementById('ws-report-summary');
        if (h) h.textContent = report.headline || 'Your workflow report';
        if (sum) sum.textContent = report.summary || '';

        var wrap = document.getElementById('ws-report-ops');
        if (wrap) {
          wrap.innerHTML = (report.opportunities || []).map(function (o, i) {
            var step = nextStepMeta(o.nextStep);
            var rows = [
              ['Current process', o.currentProcess],
              ['Trigger', o.trigger],
              ['Inputs', o.inputs],
              ['Proposed AI-assisted workflow', o.proposedWorkflow],
              ['Where a person stays in control', o.humanReview],
              ['Volume', o.volume],
              ['Estimated time saved', o.timeSaving],
            ];
            var rowsHtml = rows.map(function (r) {
              if (!r[1]) return '';
              var needsFlag = /needs confirmation/i.test(r[1]) ? ' op-ws-op-val--needs' : '';
              return (
                '<div class="op-ws-op-row">' +
                '<span class="op-ws-op-key">' + esc(r[0]) + '</span>' +
                '<span class="op-ws-op-val' + needsFlag + '">' + esc(r[1]) + '</span>' +
                '</div>'
              );
            }).join('');
            var assumptions = (o.assumptions && o.assumptions.length)
              ? '<div class="op-ws-op-assume"><span class="op-ws-op-key">Assumptions behind this</span><ul>' +
                o.assumptions.map(function (a) { return '<li>' + esc(a) + '</li>'; }).join('') +
                '</ul></div>'
              : '';
            return (
              '<article class="op-ws-op">' +
              '<div class="op-ws-op-head">' +
              '<span class="op-ws-op-num">' + String(i + 1).padStart(2, '0') + '</span>' +
              '<span class="op-ws-op-chip op-ws-op-chip--' + step.cls + '">' + step.label + '</span>' +
              '<span class="op-ws-op-chip op-ws-op-chip--risk-' + esc(o.risk || 'medium') + '">RISK ' + esc((o.risk || 'medium').toUpperCase()) + '</span>' +
              '</div>' +
              '<h4 class="op-ws-op-title">' + esc(o.title) + '</h4>' +
              rowsHtml +
              assumptions +
              '</article>'
            );
          }).join('');
        }
      }

      if (wsPrint) {
        wsPrint.addEventListener('click', function () {
          var previousTitle = document.title;
          document.title = 'Brothers Automate - AI Workflow Report';
          track('workflow_report_printed', {});
          window.print();
          setTimeout(function () { document.title = previousTitle; }, 500);
        });
      }

      wsForm.addEventListener('submit', function (e) {
        e.preventDefault();
        var err = validateStep(4);
        if (err) { setError(wsError, err); return; }

        var honeypot = val('ws-hp');
        if (honeypot) { wsForm.hidden = true; wsReport.hidden = false; return; }

        wsSubmit.disabled = true;
        wsSubmit.classList.add('is-loading');
        var label = wsSubmit.querySelector('.op-audit-submit-label');
        if (label) label.textContent = 'BUILDING YOUR REPORT…';
        if (wsStatus) wsStatus.textContent = '● ANALYZING';
        setError(wsError, '');

        var payload = {
          name: val('ws-name'),
          email: val('ws-email'),
          phone: val('ws-phone'),
          answers: {
            business_type: val('ws-business-type'),
            team_size: radioVal('team_size'),
            after_hours: val('ws-after-hours'),
            repeat_tasks: val('ws-repeat-tasks'),
            inquiries: val('ws-inquiries'),
            estimates: val('ws-estimates'),
            tools: val('ws-tools'),
            copying: val('ws-copying'),
            delays: val('ws-delays'),
            frequency: (document.getElementById('ws-frequency') || {}).value || 'not-sure',
            time_each: (document.getElementById('ws-time-each') || {}).value || 'not-sure',
            example: val('ws-example'),
          },
          website: scanData ? { url: scanData.url, domain: scanData.domain, score: scanData.score } : null,
          attribution: attributionPayload(),
          intent: 'workflow_audit',
          source: 'free-ai-audit',
        };

        fetch(WORKFLOW_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        })
          .then(function (res) {
            return res.text().then(function (bodyText) {
              var data = null;
              try { data = bodyText ? JSON.parse(bodyText) : null; } catch (parseError) {}
              if (!res.ok) {
                var safeMessage = data && data.error
                  ? data.error
                  : "We couldn't generate the report right now. Your answers are still here, so please try again.";
                throw new Error(safeMessage);
              }
              if (!data || typeof data !== 'object') {
                throw new Error("We couldn't read the completed report. Your answers are still here, so please try again.");
              }
              return data;
            });
          })
          .then(function (data) {
            // Categorical analytics only, never questionnaire text.
            track('workflow_scorecard_completed', {
              had_website: scanData ? 'yes' : 'no',
              team_size: payload.answers.team_size || '(none)',
              lead_source: payload.attribution.lead_source,
            });
            if (typeof fbq !== 'undefined') { try { fbq('track', 'Lead'); } catch (e) {} }
            renderWorkflowReport((data && data.report) || {});
            wsForm.hidden = true;
            wsReport.hidden = false;
            if (wsStatus) wsStatus.textContent = '● REPORT READY';
            track('workflow_report_viewed', { opportunities: ((data && data.report && data.report.opportunities) || []).length });
            scrollToEl(document.getElementById('ws-panel'));
          })
          .catch(function (err2) {
            wsSubmit.disabled = false;
            wsSubmit.classList.remove('is-loading');
            if (label) label.textContent = 'GET MY WORKFLOW REPORT';
            if (wsStatus) wsStatus.textContent = '● READY';
            setError(wsError, err2.message || "That didn't go through. Try again, or book Brendan below and we'll run it manually.");
          });
      });

      showStep(0, false);
    })();
  </script>

  <!-- Init Brendan's Cal.com namespace for popup booking on this page only -->
  <script is:inline>
    (function () {
      function initBrendanCal() {
        if (typeof Cal === 'undefined') return false;
        Cal('init', '30min', { origin: 'https://app.cal.com' });
        Cal.ns['30min']('ui', {
          hideEventTypeDetails: false,
          layout: 'month_view',
          useSlotsViewOnSmallScreen: 'true',
        });
        return true;
      }
      if (!initBrendanCal()) {
        var tries = 0;
        var timer = setInterval(function () {
          if (initBrendanCal() || ++tries > 50) clearInterval(timer);
        }, 200);
      }
      ['pointerdown', 'touchstart', 'keydown'].forEach(function (evt) {
        window.addEventListener(evt, initBrendanCal, { capture: true, passive: true, once: true });
      });
    })();
  </script>
</Layout>

