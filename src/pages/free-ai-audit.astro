  @media (min-width: 960px) { .op-audit-sprint-grid { grid-template-columns: 1.15fr 0.85fr; gap: 56px; align-items: start; } }
  .op-audit-sprint-body { font-family: var(--op-font-body); font-size: 15.5px; line-height: 1.65; color: rgba(244,238,226,0.82); margin: 0 0 16px; max-width: 600px; }
  .op-audit-sprint-body strong { color: var(--op-cream); }
  .op-audit-sprint-meta { font-size: 9.5px; color: var(--op-orange); margin: 4px 0 22px; display: block; }
  .op-audit-sprint-ctas { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; margin-bottom: 18px; }
  .op-audit-sprint-secondary {
    font-size: 10px;
