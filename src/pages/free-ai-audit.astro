  }
  .op-ws-pill input:checked + span { background: var(--op-navy); color: var(--op-cream); }
  .op-ws-pill input:focus-visible + span { outline: none; box-shadow: 3px 3px 0 var(--op-orange); border-color: var(--op-orange); }

  .op-ws-privacy {
    font-family: var(--op-font-body);
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--op-navy-soft);
