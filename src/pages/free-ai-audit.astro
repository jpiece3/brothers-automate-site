    gap: 10px;
    margin-bottom: 10px;
  }
  .op-ws-ops :global(.op-ws-op-num) {
    font-family: var(--op-font-mono);
    font-size: 10px;
    font-weight: 700;
    color: var(--op-navy-soft);
    letter-spacing: 0.04em;
  }
  .op-ws-ops :global(.op-ws-op-chip) {
    font-family: var(--op-font-mono);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    border-radius: 99px;
    border: 1px solid currentColor;
  }
  .op-ws-ops :global(.op-ws-op-chip--train) { color: var(--op-navy); }
  .op-ws-ops :global(.op-ws-op-chip--automate) { color: var(--green); }
  .op-ws-ops :global(.op-ws-op-chip--clarify) { color: var(--op-orange); }
  .op-ws-ops :global(.op-ws-op-chip--leave) { color: var(--red); }
  .op-ws-ops :global(.op-ws-op-chip--risk-low) { color: var(--green); opacity: 0.85; }
  .op-ws-ops :global(.op-ws-op-chip--risk-medium) { color: var(--op-orange); opacity: 0.85; }
  .op-ws-ops :global(.op-ws-op-chip--risk-high) { color: var(--red); opacity: 0.85; }
  .op-ws-ops :global(.op-ws-op-title) {
    font-family: var(--op-font-display);
    font-weight: 800;
    font-size: 17px;
    color: var(--op-ink);
    margin: 0 0 12px;
    letter-spacing: -0.01em;
  }
  .op-ws-ops :global(.op-ws-op-row) {
    display: grid;
    grid-template-columns: 168px 1fr;
    gap: 4px 14px;
    padding: 7px 0;
    border-top: 1px solid var(--op-rule-soft);
  }
  @media (max-width: 640px) {
    .op-ws-ops :global(.op-ws-op-row) { grid-template-columns: 1fr; }
  }
  .op-ws-ops :global(.op-ws-op-key) {
    font-family: var(--op-font-mono);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--op-navy-soft);
    padding-top: 2px;
  }
  .op-ws-ops :global(.op-ws-op-val) {
    font-family: var(--op-font-body);
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--op-navy);
  }
  .op-ws-ops :global(.op-ws-op-val--needs) {
    color: var(--op-orange);
    font-weight: 600;
  }
  .op-ws-ops :global(.op-ws-op-assume) {
    border-top: 1px solid var(--op-rule-soft);
    padding: 8px 0 0;
    margin-top: 2px;
  }
  .op-ws-ops :global(.op-ws-op-assume ul) {
    margin: 6px 0 0;
    padding-left: 18px;
  }
  .op-ws-ops :global(.op-ws-op-assume li) {
    font-family: var(--op-font-body);
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--op-navy-soft);
    margin-bottom: 3px;
  }

  .op-ws-report-note {
    font-family: var(--op-font-body);
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--op-navy-soft);
    margin: 0 0 20px;
  }
  .op-ws-delivery {
    font-family: var(--op-font-body);
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--op-navy);
    background: rgba(47, 133, 90, 0.08);
    border-left: 3px solid var(--green);
    padding: 10px 12px;
    margin: 0 0 18px;
  }

  .op-audit-report-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 18px; }
  .op-audit-book {
    font-family: var(--op-font-display); font-weight: 800; font-size: 13px; letter-spacing: 0.1em;
    background: var(--op-orange); color: var(--op-paper);
    border: var(--op-border); border-radius: var(--op-radius);
    padding: 13px 20px; text-decoration: none; box-shadow: var(--op-shadow);
    transition: transform var(--op-dur-hover) var(--op-ease), box-shadow var(--op-dur-hover) var(--op-ease), background var(--op-dur-hover) var(--op-ease);
  }
  .op-audit-book:hover { background: var(--op-orange-deep); color: var(--op-paper); transform: translate(-2px, -3px); box-shadow: var(--op-shadow-lg); }
  .op-audit-report-link { font-size: 10px; color: var(--op-navy); text-decoration: none; border-bottom: 1.5px solid var(--op-navy); padding-bottom: 3px; transition: color var(--op-dur-hover) var(--op-ease), border-color var(--op-dur-hover) var(--op-ease); }
  .op-audit-report-link:hover { color: var(--op-orange); border-color: var(--op-orange); }
  .op-audit-report-button { appearance: none; background: none; border: 0; border-bottom: 1.5px solid var(--op-navy); border-radius: 0; cursor: pointer; }

  /* ============================ SHARED SECTION CHROME ============================ */
  .op-audit-section-frame { max-width: var(--op-max-content); margin: 0 auto; padding: 0 var(--op-section-px); }
  .op-audit-section-head { max-width: 720px; margin-bottom: 44px; }
  .op-audit-section-head :global(.op-eyebrow) { margin-bottom: 18px; }
  .op-audit-h2 { font-family: var(--op-font-display); font-weight: 800; font-size: clamp(26px, 3.6vw, 42px); line-height: 1.02; letter-spacing: var(--op-tracking-display); color: var(--op-ink); margin: 0 0 14px; text-wrap: balance; }
  .op-audit-h2-light { color: var(--op-cream); }
  .op-audit-section-sub { font-family: var(--op-font-body); font-size: 16px; line-height: 1.6; color: var(--op-navy-soft); margin: 0; max-width: 620px; }

  /* ---- interpret ---- */
  .op-audit-interpret { background: var(--op-paper); padding: var(--op-section-py) 0; border-top: var(--op-border); border-bottom: var(--op-border); }
  .op-audit-interpret-grid { display: grid; grid-template-columns: 1fr; gap: 16px; }
  @media (min-width: 700px) { .op-audit-interpret-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .op-audit-interpret-grid { grid-template-columns: repeat(4, 1fr); } }
  .op-audit-interpret-card {
    background: var(--op-cream);
    border: var(--op-border);
    border-radius: var(--op-radius);
