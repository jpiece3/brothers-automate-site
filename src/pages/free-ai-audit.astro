  .op-audit-sprint-fineprint { font-family: var(--op-font-body); font-size: 12.5px; line-height: 1.55; color: rgba(244,238,226,0.6); margin: 0; max-width: 520px; }
  .op-audit-sprint-deliverables {
    background: var(--op-navy-deep);
    border: 1.5px solid rgba(244,238,226,0.16);
    border-radius: var(--op-radius-md);
    padding: 24px 24px 20px;
  }
  .op-audit-sprint-dhead { font-size: 9.5px; color: var(--op-orange); margin: 0 0 16px; display: block; }
  .op-audit-sprint-deliverables ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .op-audit-sprint-deliverables li {
    display: flex; gap: 12px; align-items: baseline;
    font-family: var(--op-font-body); font-size: 14px; line-height: 1.5; color: rgba(244,238,226,0.86);
    padding-bottom: 12px; border-bottom: 1px solid rgba(244,238,226,0.1);
  }
  .op-audit-sprint-deliverables li:last-child { border-bottom: none; padding-bottom: 0; }
  .op-audit-sprint-dnum { font-size: 9px; color: var(--op-orange); flex-shrink: 0; }

  /* ---- clinic ---- */
  .op-audit-clinic { padding: var(--op-section-py) 0; }
  .op-audit-clinic :global(.op-eyebrow) { margin-bottom: 18px; }
  .op-audit-clinic-grid { display: grid; grid-template-columns: 1fr; gap: 32px; }
  @media (min-width: 960px) { .op-audit-clinic-grid { grid-template-columns: 1.1fr 0.9fr; gap: 56px; align-items: start; } }
  .op-audit-clinic-ctas { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; margin-top: 24px; }
  .op-audit-clinic-points {
    list-style: none; margin: 0; padding: 22px 24px;
    background: var(--op-paper);
    border: var(--op-border);
    border-radius: var(--op-radius-md);
    box-shadow: var(--op-shadow);
