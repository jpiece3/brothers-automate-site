  /* ---- teaser gate → scorecard handoff ---- */
  .op-audit-gate { background: var(--op-navy); border-radius: var(--op-radius); padding: 22px 20px; margin: 4px -4px 0; }
  .op-audit-gate-head { display: flex; align-items: center; gap: 8px; color: var(--op-cream); font-size: 10px; }
  .op-audit-gate-head .op-mono { color: var(--op-cream); }
  .op-audit-gate-sub { font-family: var(--op-font-body); font-size: 13px; color: rgba(244,238,226,0.72); margin: 10px 0 18px; line-height: 1.5; }
  .op-audit-gate .op-audit-fineprint { color: rgba(244,238,226,0.6); }

  /* ============================ WORKFLOW SCORECARD ============================ */
  .op-audit-scorecard { padding: var(--op-section-py) 0; border-top: var(--op-border); }
  .op-ws-sample {
    max-width: 880px;
    margin: -12px 0 28px;
    padding: 22px 24px;
    background: var(--op-paper);
    border: var(--op-border);
    border-left: 4px solid var(--op-orange);
    border-radius: var(--op-radius);
    box-shadow: var(--op-shadow);
  }
  .op-ws-sample-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; margin-bottom: 18px; }
  .op-ws-sample-eyebrow { display: block; font-size: 8.5px; color: var(--op-orange); margin-bottom: 7px; }
  .op-ws-sample h3 { font-family: var(--op-font-display); font-size: 20px; line-height: 1.15; color: var(--op-ink); margin: 0; }
  .op-ws-sample .op-ws-op-chip {
