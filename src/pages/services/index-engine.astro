---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTA from '../../components/CTA.astro';
import TopUtilityStrip from '../../components/operator/TopUtilityStrip.astro';
import EyebrowTag from '../../components/operator/EyebrowTag.astro';
import SpecStrip from '../../components/operator/SpecStrip.astro';
import MonoCTA from '../../components/operator/MonoCTA.astro';

const SITE_URL = 'https://brothersautomate.com';

const title = 'Index Engine, Own the Index for Your Market | Brothers Automate';
const description =
  'We build the most complete index in your market, then staff it with AI agents that run it. You approve, they work. Live in five weeks.';

const steps = [
  { n: '01', title: 'We build the index', body: 'Every business, listing, or record in your market becomes a page. Thousands of them.' },
  { n: '02', title: 'Agents run it', body: 'They find what is missing, fix what breaks, and write the newsletter. Overnight.' },
  { n: '03', title: 'You approve', body: 'It all waits in one queue. That is your whole job now.' },
];

const roster = [
  { name: 'Orchestrator', live: 'Burbs Maestro', body: 'The one you message. Puts the others to work.', core: true },
  { name: 'Scout', live: 'Suburb Scout', body: 'Finds records you do not have yet.', core: true },
  { name: 'Editor', live: 'Happenings Herald', body: 'Pulls anything expired off your site.', core: true },
  { name: 'Watchdog', live: 'Burbhound', body: 'Catches dead links and closed doors.', core: true },
  { name: 'Broker', live: 'BrokerBurb', body: 'Works your leads and sponsors.', core: false },
  { name: 'SEO', live: 'BurbsEO', body: 'Hands you ranking wins, already scored.', core: false },
  { name: 'Implementer', live: 'SiteChange', body: 'Ships the ones you approved.', core: false },
  { name: 'Newsletter', live: 'Burbsworth Goodletter', body: 'Writes the weekly, leaves it in drafts.', core: false },
  { name: 'Social', live: 'Postburb', body: 'Posts, stories, captions.', core: false },
  { name: 'Reporting', live: 'Dashburbs', body: 'One dashboard. No more guessing.', core: false },
];

const guardrails = [
  { tool: 'Your database', denied: 'Cannot delete anything' },
  { tool: 'Your email', denied: 'Cannot hit send' },
  { tool: 'Your payments', denied: 'Cannot move a dollar' },
  { tool: 'Your codebase', denied: 'Cannot touch main' },
];

const phases = [
  { n: '01', title: 'Scope it', when: 'Week 1' },
  { n: '02', title: 'Fill it', when: 'Weeks 2 to 4' },
  { n: '03', title: 'Launch it', when: 'Week 5' },
  { n: '04', title: 'Staff it', when: 'Weeks 5 to 8' },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE_URL}/services/` },
    { '@type': 'ListItem', position: 3, name: 'Index Engine', item: `${SITE_URL}/services/index-engine` },
  ],
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Index Engine',
  description:
    'Done-for-you indexed sites backed by a roster of AI agents that handle ingestion, data quality, SEO, newsletter, and lead follow-up under human approval.',
  serviceType: 'AI automation and content operations',
  provider: { '@type': 'Organization', name: 'Brothers Automate', url: SITE_URL },
  areaServed: 'Worldwide',
};
---

<Layout title={title} description={description} canonicalUrl={`${SITE_URL}/services/index-engine`}>
  <Header />
  <main>
    <!-- HERO -->
    <section class="ie-hero op-grid-bg">
      <div class="ie-frame">
        <div class="ie-util">
          <TopUtilityStrip
            left="BROTHERS_AUTOMATE / SERVICES · INDEX_ENGINE"
            right="10 AGENTS · 1 HUMAN STEP"
            bordered
          />
        </div>
        <EyebrowTag label="SERVICES · INDEX ENGINE" />
        <h1 class="ie-h1" data-animate="fade-up">
          Be the one<br />
          <span class="ie-orange">everybody checks.</span>
        </h1>
        <p class="ie-sub" data-animate="fade-up">
          We build the most complete index in your market, then staff it with agents that run it
          while you sleep.
        </p>
        <div class="ie-hero-cta" data-animate="fade-up">
          <MonoCTA
            label="Talk to the Brothers"
            href="/book"
            size="lg"
            trackLocation="index-engine-hero"
            trackLabel="Talk to the Brothers"
          />
        </div>
        <div class="ie-hero-specs">
          <SpecStrip
            cells={[
              { value: '1,900+', label: 'Pages indexed' },
              { value: '10', label: 'Agents on staff' },
              { value: '2 hrs', label: 'Refresh cycle' },
              { value: '1', label: 'Human step' },
            ]}
          />
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section class="ie-how">
      <div class="ie-frame">
        <EyebrowTag label="HOW IT WORKS" variant="paper" />
        <h2 class="ie-h2 ie-h2--light">Three moving parts.</h2>

        <div class="ie-steps">
          {steps.map((s) => (
            <div class={`ie-step${s.n === '03' ? ' ie-step--you' : ''}`}>
              <div class="ie-step-n op-mono">{s.n}</div>
              <h3 class="ie-step-title">{s.title}</h3>
              <p>{s.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- WATCH IT -->
    <section class="ie-run">
      <div class="ie-frame">
        <EyebrowTag label="A REAL RUN" />
        <h2 class="ie-h2">Nobody asked it<br /><span class="ie-orange">to do this.</span></h2>
        <p class="ie-lede">
          It read what visitors were asking our site, found demand we were missing, and put two
          agents on it. Then it stopped and asked us what to do.
        </p>

        <figure class="ie-video-wrap">
          <video
            class="ie-video"
            autoplay
            muted
            loop
            playsinline
            controls
            preload="metadata"
            poster="/video/index-engine-run-poster.jpg"
            aria-label="An agent reading visitor questions, then dispatching two other agents"
          >
            <source src="/video/index-engine-run.webm" type="video/webm" />
            <source src="/video/index-engine-run.mp4" type="video/mp4" />
          </video>
          <figcaption class="ie-video-cap op-mono">LIVE RUN · GOODBURBS.COM</figcaption>
        </figure>
      </div>
    </section>

    <!-- ROSTER -->
    <section class="ie-roster">
      <div class="ie-frame">
        <EyebrowTag label="THE ROSTER" />
        <h2 class="ie-h2">Ten agents.<br /><span class="ie-orange">One you talk to.</span></h2>
        <p class="ie-lede">
          These run The Good Burbs right now. Start with the four marked core. Add the rest when it
          starts paying for itself.
        </p>

        <div class="ie-cards" data-animate-stagger>
          {roster.map((a) => (
            <article class={`ie-card${a.core ? ' ie-card--core' : ''}`}>
              <div class="ie-card-top">
                <h3 class="ie-card-name">{a.name}</h3>
                {a.core && <span class="op-mono ie-card-core">CORE</span>}
              </div>
              <p class="ie-card-text">{a.body}</p>
              <div class="ie-card-live op-mono">{a.live}</div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- GUARDRAILS -->
    <section class="ie-guard">
      <div class="ie-frame">
        <EyebrowTag label="GUARDRAILS" variant="paper" />
        <h2 class="ie-h2 ie-h2--light">Nothing moves<br /><span class="ie-orange">unless you say so.</span></h2>

        <div class="ie-guard-grid">
          {guardrails.map((g) => (
            <div class="ie-guard-cell">
              <div class="ie-guard-tool">{g.tool}</div>
              <div class="ie-guard-no">{g.denied}</div>
            </div>
          ))}
        </div>

        <p class="ie-guard-note">
          Not a politely worded instruction. The dangerous doors are locked at the hinge.
        </p>
      </div>
    </section>

    <!-- PROOF -->
    <section class="ie-proof">
      <div class="ie-frame">
        <EyebrowTag label="PROOF" />
        <h2 class="ie-h2">Both of these<br /><span class="ie-orange">are ours.</span></h2>

        <div class="ie-proofs">
          <a class="ie-proof-card" href="https://goodburbs.com/" target="_blank" rel="noopener">
            <picture>
              <source srcset="/images/goodburbs-home.webp" type="image/webp" />
              <img
                class="ie-proof-shot"
                src="/images/goodburbs-home.jpg"
                width="1440"
                height="880"
                loading="lazy"
                decoding="async"
                alt="The Good Burbs homepage, a field guide to 24 Philadelphia suburb towns"
              />
            </picture>
            <div class="ie-proof-head op-mono">THE GOOD BURBS <span>goodburbs.com ↗</span></div>
            <div class="ie-proof-body">
              <p class="ie-proof-lede">Every place worth knowing across 24 towns.</p>
              <SpecStrip
                compact
                cells={[
                  { value: '24', label: 'Towns' },
                  { value: '1,900+', label: 'Places' },
                  { value: '400', label: 'Events' },
                ]}
              />
            </div>
          </a>

          <a class="ie-proof-card" href="https://www.mfmindex.com/" target="_blank" rel="noopener">
            <picture>
              <source srcset="/images/mfmindex-home.webp" type="image/webp" />
              <img
                class="ie-proof-shot"
                src="/images/mfmindex-home.jpg"
                width="1440"
                height="880"
                loading="lazy"
                decoding="async"
                alt="MFM Index homepage, a searchable archive of 885 podcast episodes"
              />
            </picture>
            <div class="ie-proof-head op-mono">MFM INDEX <span>mfmindex.com ↗</span></div>
            <div class="ie-proof-body">
              <p class="ie-proof-lede">800 hours of audio you can actually search.</p>
              <SpecStrip
                compact
                cells={[
                  { value: '885', label: 'Episodes' },
                  { value: '13,488', label: 'Moments' },
                  { value: '800+', label: 'Hours' },
                ]}
              />
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- BUILD -->
    <section class="ie-build">
      <div class="ie-frame">
        <EyebrowTag label="THE BUILD" />
        <h2 class="ie-h2">Live in five weeks.<br /><span class="ie-orange">Staffed by eight.</span></h2>

        <div class="ie-phases">
          {phases.map((p) => (
            <div class="ie-phase">
              <span class="ie-phase-n op-mono">{p.n}</span>
              <h3 class="ie-phase-title">{p.title}</h3>
              <span class="ie-phase-when op-mono">{p.when}</span>
            </div>
          ))}
        </div>

        <p class="ie-build-note">
          One honest catch: your first run drops a thousand drafts in your lap, and every one needs a
          human eye. We scope that up front.
        </p>
      </div>
    </section>
  </main>

  <CTA />
  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <script>
    // Respect reduced-motion: hold the run video on its poster instead of looping.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const v = document.querySelector('.ie-video');
      if (v instanceof HTMLVideoElement) {
        v.autoplay = false;
        v.loop = false;
        v.pause();
      }
    }
  </script>
</Layout>

<style>
  .ie-frame { max-width: var(--op-max-content); margin: 0 auto; }

  .ie-h1 {
    font-family: var(--op-font-display);
    font-weight: 800;
    font-size: clamp(46px, 6.4vw, 88px);
    line-height: 0.98;
    letter-spacing: var(--op-tracking-display);
    color: var(--op-ink);
    margin: 0 0 22px;
    max-width: 900px;
    text-wrap: balance;
  }
  .ie-orange { color: var(--op-orange); }

  .ie-h2 {
    font-family: var(--op-font-display);
    font-weight: 800;
    font-size: clamp(34px, 4vw, 56px);
    line-height: 1.02;
    letter-spacing: var(--op-tracking-display);
    color: var(--op-ink);
    margin: 22px 0 16px;
    text-wrap: balance;
  }
  .ie-h2--light { color: var(--op-cream); }

  .ie-sub, .ie-lede {
    font-family: var(--op-font-body);
    font-size: 17px;
    line-height: 1.55;
    font-weight: 500;
    color: var(--op-navy-soft);
    margin: 0;
    max-width: 560px;
    text-wrap: pretty;
  }

  /* HERO */
  .ie-hero { padding: 120px var(--op-section-px) 72px; }
  .ie-util { margin-bottom: 32px; }
  .ie-hero :global(.op-eyebrow) { margin-bottom: 24px; }
  .ie-hero-cta { margin-top: 30px; }
  .ie-hero-specs { margin-top: 48px; max-width: 900px; }

  /* HOW IT WORKS */
  .ie-how { padding: var(--op-section-py) var(--op-section-px); background: var(--op-navy); border-top: var(--op-border); }
  .ie-steps { display: grid; grid-template-columns: 1fr; gap: 0; margin-top: 40px;
    border: 1.5px solid rgba(244, 238, 226, 0.22); border-radius: var(--op-radius-md); overflow: hidden; }
  @media (min-width: 860px) { .ie-steps { grid-template-columns: repeat(3, 1fr); } }
  .ie-step {
    padding: 32px 28px;
    border-bottom: 1px solid rgba(244, 238, 226, 0.16);
    border-right: 1px solid rgba(244, 238, 226, 0.16);
  }
  .ie-step--you { background: var(--op-navy-deep); }
  .ie-step-n { font-size: 11px; color: var(--op-orange); }
  .ie-step-title {
    font-family: var(--op-font-display);
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--op-cream);
    margin: 12px 0 10px;
  }
  .ie-step p { margin: 0; font-size: 15px; line-height: 1.55; color: rgba(244, 238, 226, 0.66); }

  /* RUN */
  .ie-run { padding: var(--op-section-py) var(--op-section-px); background: var(--op-paper); border-top: var(--op-border); }
  .ie-video-wrap { margin: 36px 0 0; max-width: 940px; }
  .ie-video {
    display: block;
    width: 100%;
    height: auto;
    border: var(--op-border);
    border-radius: var(--op-radius-md);
    box-shadow: var(--op-shadow-lg);
    background: var(--op-navy);
  }
  .ie-video-cap { font-size: 9px; color: var(--op-navy-soft); margin-top: 14px; }

  /* ROSTER */
  .ie-roster { padding: var(--op-section-py) var(--op-section-px); background: var(--op-cream); border-top: var(--op-border); }
  .ie-cards { display: grid; grid-template-columns: 1fr; gap: 16px; margin-top: 40px; }
  @media (min-width: 620px) { .ie-cards { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .ie-cards { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1240px) { .ie-cards { grid-template-columns: repeat(5, 1fr); } }
  .ie-card {
    background: var(--op-paper);
    border: var(--op-border);
    border-radius: var(--op-radius-md);
    box-shadow: var(--op-shadow);
    padding: 20px;
    display: flex;
    flex-direction: column;
    transition: transform 200ms var(--op-ease), box-shadow 200ms var(--op-ease);
  }
  .ie-card:hover { transform: translate(-2px, -4px); box-shadow: var(--op-shadow-lg); }
  .ie-card--core { border-left: 5px solid var(--op-orange); }
  .ie-card-top { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
  .ie-card-name {
    font-family: var(--op-font-display);
    font-size: 18px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--op-ink);
    margin: 0;
  }
  .ie-card-core {
    font-size: 8px;
    margin-left: auto;
    background: var(--op-orange);
    color: var(--op-navy);
    padding: 2px 6px;
    border-radius: 3px;
  }
  .ie-card-text { font-size: 14.5px; line-height: 1.5; color: var(--op-navy-soft); margin: 0 0 14px; flex: 1; }
  .ie-card-live {
    font-size: 8.5px;
    color: var(--op-navy);
    padding-top: 11px;
    border-top: 1px dashed var(--op-rule);
  }

  /* GUARDRAILS */
  .ie-guard { padding: var(--op-section-py) var(--op-section-px); background: var(--op-navy); border-top: var(--op-border); }
  .ie-guard-grid { display: grid; grid-template-columns: 1fr; gap: 0; margin-top: 40px; max-width: 940px;
    border: 1.5px solid rgba(244, 238, 226, 0.22); border-radius: var(--op-radius-md); overflow: hidden; }
  @media (min-width: 760px) { .ie-guard-grid { grid-template-columns: 1fr 1fr; } }
  .ie-guard-cell {
    padding: 22px 24px;
    border-bottom: 1px solid rgba(244, 238, 226, 0.14);
    border-right: 1px solid rgba(244, 238, 226, 0.14);
  }
  .ie-guard-tool { color: rgba(244, 238, 226, 0.6); font-size: 14px; margin-bottom: 5px; }
  .ie-guard-no {
    color: var(--op-orange);
    font-family: var(--op-font-display);
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .ie-guard-note { margin: 22px 0 0; max-width: 600px; font-size: 15px; line-height: 1.6; color: rgba(244, 238, 226, 0.66); }

  /* PROOF */
  .ie-proof { padding: var(--op-section-py) var(--op-section-px); background: var(--op-cream); border-top: var(--op-border); }
  .ie-proofs { display: grid; grid-template-columns: 1fr; gap: 22px; margin-top: 40px; }
  @media (min-width: 860px) { .ie-proofs { grid-template-columns: 1fr 1fr; } }
  .ie-proof-card {
    background: var(--op-paper);
    border: var(--op-border);
    border-radius: var(--op-radius-md);
    box-shadow: var(--op-shadow-md);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 200ms var(--op-ease), box-shadow 200ms var(--op-ease);
  }
  .ie-proof-card:hover { transform: translate(-2px, -4px); box-shadow: var(--op-shadow-lg); color: inherit; }
  .ie-proof-shot {
    display: block;
    width: 100%;
    height: auto;
    border-bottom: var(--op-border);
  }
  .ie-proof-head {
    background: var(--op-navy-deep);
    color: var(--op-orange);
    font-size: 10px;
    padding: 11px 16px;
    border-bottom: var(--op-border);
    display: flex;
    justify-content: space-between;
    gap: 10px;
  }
  .ie-proof-head span { color: rgba(244, 238, 226, 0.65); }
  .ie-proof-body { padding: 24px; }
  .ie-proof-lede {
    font-family: var(--op-font-display);
    font-size: 19px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--op-ink);
    margin: 0 0 20px;
  }

  /* BUILD */
  .ie-build { padding: var(--op-section-py) var(--op-section-px); background: var(--op-paper); border-top: var(--op-border); }
  .ie-phases { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 40px; }
  @media (min-width: 860px) { .ie-phases { grid-template-columns: repeat(4, 1fr); } }
  .ie-phase {
    background: var(--op-cream);
    border: var(--op-border);
    border-radius: var(--op-radius-md);
    box-shadow: var(--op-shadow);
    padding: 22px;
  }
  .ie-phase-n { font-size: 11px; color: var(--op-orange); display: block; }
  .ie-phase-title {
    font-family: var(--op-font-display);
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--op-ink);
    margin: 10px 0 8px;
  }
  .ie-phase-when { font-size: 9px; color: var(--op-navy-soft); }
  .ie-build-note { margin: 26px 0 0; max-width: 620px; font-size: 15px; line-height: 1.6; color: var(--op-navy-soft); }

  @media (max-width: 900px) {
    .ie-hero { padding: 96px 24px 56px; }
    .ie-how, .ie-run, .ie-roster, .ie-guard, .ie-proof, .ie-build { padding: 56px 24px 64px; }
  }
</style>
