---
import Layout from '../../layouts/Layout.astro';

// Printable AI Workflow Worksheet. Deliberately minimal chrome: this page is
// designed to be printed or saved as a PDF from the browser, so it skips the
// site header/footer and uses print-friendly styles.

const PAGE_URL = 'https://brothersautomate.com/free-ai-audit/worksheet/';

const worksheetRows = [
  { label: 'Task', hint: 'One specific piece of work, e.g. "reply to inbound quote requests"' },
  { label: 'Trigger', hint: 'What kicks it off? An email, a call, a date, a form submission?' },
  { label: 'Inputs', hint: 'What information or documents does it need to get done right?' },
  { label: 'Rules', hint: 'How do you know a good output from a bad one? What are the constraints?' },
  { label: 'Human owner', hint: 'Who owns this task, and where must a person review or approve?' },
  { label: 'Current volume', hint: 'How often does it happen? Per day / week / month.' },
  { label: 'Current time per occurrence', hint: 'How long does one occurrence take today?' },
  { label: 'Risk if wrong', hint: 'What happens if the output is wrong? Annoyance, lost money, legal trouble?' },
  { label: 'Before / after measurement', hint: 'How will you know it improved? Pick one number to watch.' },
];

const scorecardRows = [
  { factor: 'Repetition', weight: '× 3', hint: 'Does it happen the same way, over and over?' },
  { factor: 'Time consumed', weight: '× 2', hint: 'How much total time does it eat per week?' },
  { factor: 'Clarity of good output', weight: '× 2', hint: 'Is it easy to judge whether the result is right?' },
  { factor: 'Business value', weight: '× 2', hint: 'Does improving it affect revenue, speed, or customers?' },
  { factor: 'Risk if wrong', weight: '× −3', hint: 'Higher risk subtracts. Regulated, legal, or safety work scores high here.' },
];
---

<Layout
  title="AI Workflow Worksheet | Brothers Automate"
  description="A one-page worksheet for mapping a business workflow before applying AI: task, trigger, inputs, rules, human owner, volume, time, and risk."
  canonicalUrl={PAGE_URL}
  noindex={true}
>
  <main class="ws-page">
    <div class="ws-doc">
      <header class="ws-doc-head">
        <div class="ws-brand">
          <span class="ws-brand-name">BROTHERS AUTOMATE</span>
          <span class="ws-brand-sub">brothersautomate.com/free-ai-audit</span>
        </div>
        <button type="button" class="ws-print-btn" id="ws-print" data-track="cta_click" data-track-location="worksheet" data-track-label="Print Worksheet">
          PRINT / SAVE AS PDF
        </button>
      </header>

      <h1 class="ws-title">AI Workflow Worksheet</h1>
      <p class="ws-intro">
        Pick one piece of work your team repeats every week and fill this in. If you can complete
        every row, the workflow is well enough understood to improve, with AI training, an
        automation, or sometimes just a clearer process. If you get stuck on a row, that row is
        where the work starts.
      </p>

      <table class="ws-table">
        <thead>
          <tr>
            <th class="ws-col-label" scope="col">Field</th>
            <th scope="col">Your answer</th>
          </tr>
        </thead>
        <tbody>
          {worksheetRows.map((row) => (
            <tr>
              <th scope="row">
                <span class="ws-row-label">{row.label}</span>
                <span class="ws-row-hint">{row.hint}</span>
              </th>
              <td class="ws-write-cell"></td>
            </tr>
          ))}
        </tbody>
      </table>

      <h2 class="ws-subtitle">Workflow Scorecard</h2>
      <p class="ws-intro">
        Rate the workflow 0-5 on each factor, multiply by the weight, then add it up.
        Note that <strong>risk subtracts</strong>: a high-risk task scores lower on purpose.
        Higher totals are better AI candidates. Low or negative totals usually mean train the
        team, clarify the process first, or leave it alone.
      </p>

      <table class="ws-table ws-score-table">
        <thead>
          <tr>
            <th scope="col">Factor</th>
            <th scope="col" class="ws-col-narrow">Weight</th>
            <th scope="col" class="ws-col-narrow">Score (0-5)</th>
            <th scope="col" class="ws-col-narrow">Weighted</th>
          </tr>
        </thead>
        <tbody>
          {scorecardRows.map((row) => (
            <tr>
              <th scope="row">
                <span class="ws-row-label">{row.factor}</span>
                <span class="ws-row-hint">{row.hint}</span>
              </th>
              <td class="ws-weight">{row.weight}</td>
              <td class="ws-write-cell"></td>
              <td class="ws-write-cell"></td>
            </tr>
          ))}
          <tr class="ws-total-row">
            <th scope="row"><span class="ws-row-label">Total</span></th>
            <td></td>
            <td></td>
            <td class="ws-write-cell"></td>
          </tr>
        </tbody>
      </table>

      <div class="ws-legend">
        <p><strong>Reading the total:</strong></p>
        <ul>
          <li><strong>25+</strong> — strong candidate; worth scoping for automation or serious AI assistance.</li>
          <li><strong>10-24</strong> — good training candidate; the owner keeps the task, AI helps with drafts.</li>
          <li><strong>Below 10</strong> — clarify the process first, or leave it alone.</li>
        </ul>
      </div>

      <footer class="ws-doc-foot">
        <p>
          Free AI Workflow Audit: <strong>brothersautomate.com/free-ai-audit</strong>
          &nbsp;·&nbsp; Do not write passwords, private customer data, medical details, or payment
          information on this sheet if you plan to share it.
        </p>
      </footer>
    </div>
  </main>

  <script is:inline>
    (function () {
      var btn = document.getElementById('ws-print');
      if (btn) {
        btn.addEventListener('click', function () {
          if (typeof gtag !== 'undefined') { try { gtag('event', 'worksheet_print', { page: 'worksheet' }); } catch (e) {} }
          window.print();
        });
      }
    })();
  </script>
</Layout>

<style>
  .ws-page {
    background: var(--op-cream);
    min-height: 100vh;
    padding: 48px 20px 64px;
  }
  .ws-doc {
    max-width: 820px;
    margin: 0 auto;
    background: var(--op-paper);
    border: var(--op-border);
    border-radius: var(--op-radius-md);
    box-shadow: var(--op-shadow-lg);
    padding: 40px 44px 36px;
  }
  .ws-doc-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    border-bottom: 2px solid var(--op-ink);
    padding-bottom: 14px;
    margin-bottom: 26px;
  }
  .ws-brand { display: flex; flex-direction: column; gap: 3px; }
  .ws-brand-name {
    font-family: var(--op-font-display);
    font-weight: 800;
    font-size: 15px;
    letter-spacing: 0.08em;
    color: var(--op-navy);
  }
  .ws-brand-sub {
    font-family: var(--op-font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    color: var(--op-navy-soft);
  }
  .ws-print-btn {
    font-family: var(--op-font-display);
    font-weight: 800;
    font-size: 11px;
    letter-spacing: 0.12em;
    background: var(--op-orange);
    color: var(--op-paper);
    border: var(--op-border);
    border-radius: var(--op-radius);
    padding: 10px 16px;
    cursor: pointer;
    box-shadow: var(--op-shadow);
    transition: transform var(--op-dur-hover) var(--op-ease), background var(--op-dur-hover) var(--op-ease);
  }
  .ws-print-btn:hover { background: var(--op-orange-deep); transform: translate(-1px, -2px); }

  .ws-title {
    font-family: var(--op-font-display);
    font-weight: 800;
    font-size: clamp(26px, 4vw, 36px);
    letter-spacing: var(--op-tracking-display);
    color: var(--op-ink);
    margin: 0 0 12px;
  }
  .ws-subtitle {
    font-family: var(--op-font-display);
    font-weight: 800;
    font-size: 22px;
    color: var(--op-ink);
    margin: 34px 0 10px;
  }
  .ws-intro {
    font-family: var(--op-font-body);
    font-size: 14px;
    line-height: 1.6;
    color: var(--op-navy);
    margin: 0 0 20px;
  }

  .ws-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 8px;
  }
  .ws-table th, .ws-table td {
    border: 1.5px solid var(--op-ink);
    padding: 10px 12px;
    text-align: left;
    vertical-align: top;
  }
  .ws-table thead th {
    font-family: var(--op-font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--op-navy);
    color: var(--op-cream);
  }
  .ws-col-label { width: 42%; }
  .ws-col-narrow { width: 14%; }
  .ws-row-label {
    display: block;
    font-family: var(--op-font-display);
    font-weight: 800;
    font-size: 13.5px;
    color: var(--op-ink);
    margin-bottom: 3px;
  }
  .ws-row-hint {
    display: block;
    font-family: var(--op-font-body);
    font-size: 11.5px;
    line-height: 1.45;
    font-weight: 400;
    color: var(--op-navy-soft);
  }
  .ws-write-cell { min-height: 44px; height: 52px; background: var(--op-paper); }
  .ws-weight {
    font-family: var(--op-font-mono);
    font-weight: 700;
    font-size: 13px;
    color: var(--op-orange);
    white-space: nowrap;
  }
  .ws-total-row th, .ws-total-row td { background: var(--op-cream); }

  .ws-legend {
    font-family: var(--op-font-body);
    font-size: 13px;
    line-height: 1.6;
    color: var(--op-navy);
    margin-top: 18px;
  }
  .ws-legend p { margin: 0 0 6px; }
  .ws-legend ul { margin: 0; padding-left: 20px; }
  .ws-legend li { margin-bottom: 4px; }

  .ws-doc-foot {
    border-top: 1.5px solid var(--op-rule);
    margin-top: 28px;
    padding-top: 14px;
  }
  .ws-doc-foot p {
    font-family: var(--op-font-mono);
    font-size: 9.5px;
    letter-spacing: 0.04em;
    line-height: 1.6;
    color: var(--op-navy-soft);
    margin: 0;
  }

  @media (max-width: 640px) {
    .ws-doc { padding: 26px 20px 24px; }
    .ws-doc-head { flex-direction: column; align-items: flex-start; }
    .ws-col-label { width: 46%; }
  }

  @media print {
    .ws-page { background: #fff; padding: 0; }
    .ws-doc { border: none; box-shadow: none; border-radius: 0; padding: 0; max-width: none; }
    .ws-print-btn { display: none; }
    .ws-write-cell { height: 48px; }
    .ws-score-table { page-break-inside: avoid; }
  }
</style>
