# AI Workflow Audit report delivery (server-only)
# Create a Resend API key and verify the domain used by AUDIT_FROM_EMAIL.
RESEND_API_KEY=
AUDIT_FROM_EMAIL="Brothers Automate <audit@brothersautomate.com>"
# Set these to Brendan's confirmed mailbox before merging.
AUDIT_NOTIFICATION_EMAIL=
AUDIT_REPLY_TO_EMAIL=

# Existing lead notification workflow. The workflow-report submission sends
# the full report plus notification_type=workflow_report_created so the
# existing automation can alert Brendan immediately as a fallback.
AUDIT_WEBHOOK_URL=
AUDIT_WEBHOOK_AUTH=
